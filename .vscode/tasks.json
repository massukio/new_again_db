{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run App",
            "type": "shell",
            "command": "python3 start.py",
            "windows": {
                "command": "python start.py"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Launch the app (auto-runs setup if needed)"
        },
        {
            "label": "Build Standalone",
            "type": "shell",
            "command": "uv run pyinstaller new_again_db.spec",
            "windows": {
                "command": "uv run pyinstaller new_again_db.spec"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Build standalone executable via PyInstaller (output in dist/)"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "uv run pytest tests/ -v",
            "windows": {
                "command": "uv run pytest tests/ -v"
            },
            "group": "test",
            "problemMatcher": [],
            "detail": "Run all pytest tests"
        }
    ]
}
